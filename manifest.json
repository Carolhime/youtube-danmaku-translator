{
  "manifest_version": 3,
  "name": "YouTube Danmaku Translator",
  "version": "1.3.0",
  "description": "Real-time translation of YouTube danmaku (live chat / chat replay) with bilingual display",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://www.youtube.com/*",
    "*://translate.googleapis.com/*",
    "*://api.mymemory.translated.net/*",
    "*://libretranslate.com/*",
    "*://elephant.browser.360.cn/*",
    "*://index-translate.bilibili.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["lib/translator.js"],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["content/chat-inject.js"],
      "css": ["styles/danmaku.css"],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["content/main-inject.js"],
      "css": ["styles/danmaku.css"],
      "all_frames": false,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Danmaku Translator"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": ["*://www.youtube.com/*"]
    }
  ]
}
